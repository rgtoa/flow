# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — only used by the seed script, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── User credentials (server-only, no NEXT_PUBLIC_ prefix) ────
# These are the actual Supabase Auth accounts for Rafael and Thrisha.
# The pattern lock maps to these under the hood; passwords never reach the browser.
RAFAEL_EMAIL=rafael@flow.app
RAFAEL_PASSWORD=change-me-rafael-2026

THRISHA_EMAIL=thrisha@flow.app
THRISHA_PASSWORD=change-me-thrisha-2026
